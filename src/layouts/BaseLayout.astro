---
import { SITE } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Đường dẫn ảnh cover của bài viết (VD: /images/ten-bai/cover.png) — dùng cho OG + hero */
  image?: string;
  /** Trang bài viết → og:type article */
  isArticle?: boolean;
}

const { title, description, image, isArticle = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);

// Ảnh OG: ưu tiên ảnh của bài, fallback ảnh mặc định của site
const ogImage = new URL(image ?? SITE.ogImage, Astro.site ?? SITE.url);

const socialLinks = Object.entries(SITE.social).filter(
  ([, url]) => url !== ''
);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL('/rss.xml', Astro.site ?? SITE.url)}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Đặt theme từ localStorage TRƯỚC khi render để không bị nháy sáng/tối.
         'auto' (mặc định) không đặt thuộc tính → CSS tự theo hệ điều hành. -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch {}
      })();
    </script>

    <!-- Open Graph / Twitter Card (đã bao gồm ảnh OG 1200×630) -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="wrapper">
      <header class="site-header">
        <a class="brand" href="/">{SITE.title}</a>
        <nav class="site-nav" aria-label="Điều hướng chính">
          <a href="/blog">Blog</a>
          <a href="/about">Giới thiệu</a>
        </nav>
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          data-state="auto"
          aria-label="Chế độ giao diện: Tự động theo hệ điều hành"
          title="Tự động → Sáng → Tối"
        >
          <svg
            class="theme-icon theme-icon-auto"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
          </svg>
          <svg
            class="theme-icon theme-icon-light"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <path
              d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
            ></path>
          </svg>
          <svg
            class="theme-icon theme-icon-dark"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          © {new Date().getFullYear()}
          {SITE.author} ·
          <a href="/rss.xml">RSS</a>
          {
            socialLinks.map(([key, url]) => (
              <>
                {' · '}
                <a href={url} rel="me noopener" target="_blank">
                  {key}
                </a>
              </>
            ))
          }
        </p>
      </footer>
    </div>

    <noscript>
      <style>
        .theme-toggle {
          display: none !important;
        }
      </style>
    </noscript>

    <!-- Vòng lặp theme: Tự động → Sáng → Tối, ghi nhớ trong localStorage -->
    <script is:inline>
      (() => {
        const KEY = 'theme';
        const ORDER = ['auto', 'light', 'dark'];
        const NAMES = {
          auto: 'Tự động theo hệ điều hành',
          light: 'Sáng',
          dark: 'Tối',
        };
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;

        const current = () => {
          const t = localStorage.getItem(KEY);
          return ORDER.includes(t) ? t : 'auto';
        };

        const apply = (t) => {
          if (t === 'auto') {
            delete document.documentElement.dataset.theme;
          } else {
            document.documentElement.dataset.theme = t;
          }
          try {
            localStorage.setItem(KEY, t);
          } catch {}
          btn.dataset.state = t;
          btn.setAttribute('aria-label', 'Chế độ giao diện: ' + NAMES[t]);
        };

        btn.addEventListener('click', () => {
          apply(ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]);
        });

        btn.dataset.state = current();
      })();
    </script>
  </body>
</html>
