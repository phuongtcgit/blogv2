---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostNavigation } from '../../lib/posts';
import PostList from '../../components/PostList.astro';
import TagSidebar from '../../components/TagSidebar.astro';

const { posts, tags, tagsByPostId } = await getPostNavigation();
---

<BaseLayout title="Tất cả bài viết" wide>
  <h1 class="page-title">Tất cả bài viết</h1>

  <div class="posts-with-sidebar posts-with-sidebar--blog">
    <section aria-label="Danh sách bài viết">
      <PostList posts={posts} tagsByPostId={tagsByPostId} />
    </section>
    <TagSidebar tags={tags} />
  </div>
</BaseLayout>
