---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/utils';
import { getPostNavigation } from '../../lib/posts';
import TagList from '../../components/TagList.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import PostList from '../../components/PostList.astro';
import { getRelatedPosts } from '../../lib/related-posts';

export async function getStaticPaths() {
  const { posts, tagsByPostId } = await getPostNavigation();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      tags: tagsByPostId.get(post.id) ?? [],
      relatedPosts: getRelatedPosts(post.id, tagsByPostId),
    },
  }));
}

const { post, tags, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  isArticle
>
  <article>
    {
      post.data.image && (
        <img
          class="post-cover"
          src={post.data.image}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
        />
      )
    }
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </p>
    </header>

    <ArticleToc headings={headings} />

    <div class="prose">
      <Content />
    </div>

    {tags.length > 0 && (
      <nav class="article-tags" aria-label="Chủ đề của bài viết">
        <TagList tags={tags} />
      </nav>
    )}

    {relatedPosts.length > 0 && (
      <section class="related-posts" aria-label="Bài viết liên quan">
        <h2 class="section-title">Bài viết liên quan</h2>
        <PostList posts={relatedPosts} />
      </section>
    )}

    <a class="back-link" href="/blog">← Về danh sách bài viết</a>
  </article>
  <CodeCopy />
</BaseLayout>
