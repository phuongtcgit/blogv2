---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/utils';
import { getPostNavigation } from '../../lib/posts';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const { posts, tagsByPostId } = await getPostNavigation();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, tags: tagsByPostId.get(post.id) ?? [] },
  }));
}

const { post, tags } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  isArticle
>
  <article>
    {
      post.data.image && (
        <img
          class="post-cover"
          src={post.data.image}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
        />
      )
    }
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {tags.length > 0 && (
      <nav class="article-tags" aria-label="Chủ đề của bài viết">
        <TagList tags={tags} />
      </nav>
    )}

    <a class="back-link" href="/blog">← Về danh sách bài viết</a>
  </article>
</BaseLayout>
