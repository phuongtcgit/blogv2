---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { englishLessons as lessons } from '../../lib/english-library';
import EnglishGradeNav from '../../components/EnglishGradeNav.astro';
import EnglishLessonList from '../../components/EnglishLessonList.astro';
---

<BaseLayout title="English cùng con" description="Các bài học tiếng Anh cùng con: từ vựng, phát âm, bài hát và trò chơi.">
  <h1 class="page-title">English cùng con</h1>
  <p class="topic-note">Cùng học từ vựng, nghe phát âm, hát và chơi bằng tiếng Anh.</p>
  <EnglishGradeNav lessons={lessons} />

  {lessons.length ? (
    <section aria-labelledby="english-lessons">
      <h2 class="section-title" id="english-lessons">{lessons.length} bài học</h2>
      <EnglishLessonList lessons={lessons} showGrade />
    </section>
  ) : (
    <p class="topic-note">Bài học mới sẽ sớm được cập nhật.</p>
  )}
</BaseLayout>
