---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { getPostNavigation } from '../lib/posts';
import PostList from '../components/PostList.astro';
import TagSidebar from '../components/TagSidebar.astro';

const { posts: allPosts, tags } = await getPostNavigation();
const recent = allPosts.slice(0, SITE.recentPosts);
---

<BaseLayout wide>
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p>{SITE.description}</p>
  </section>

  <div class="posts-with-sidebar">
    <section aria-labelledby="recent-posts">
      <h2 class="section-title" id="recent-posts">Bài viết mới</h2>
      <PostList posts={recent} />
      <p style="margin-top: 1.5rem">
        <a href="/blog">Xem tất cả bài viết →</a>
      </p>
    </section>
    <TagSidebar tags={tags} />
  </div>
</BaseLayout>
