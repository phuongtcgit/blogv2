---
import type { EnglishGrade } from '../lib/english-grades';
import { ENGLISH_WORKBOOKS } from '../lib/english-workbooks';

interface Props { grade: EnglishGrade; reinforcementCount?: number }
const workbook = ENGLISH_WORKBOOKS.find(({ grade }) => grade === Astro.props.grade);
const { reinforcementCount = 0 } = Astro.props;
---

{workbook && (
  <aside class="workbook-link" aria-label={workbook.title}>
    <div>
      <h2>{workbook.title}</h2>
      <p>{workbook.description}</p>
      {reinforcementCount > 0 && <p>Thêm {reinforcementCount} bài tăng cường: nhớ chữ, tập viết, ghép chữ, nghe và nói.</p>}
    </div>
    <div class="workbook-actions">
      <a href={workbook.url}>Làm bài tập →</a>
      {reinforcementCount > 0 && <a class="reinforcement-link" href={`/english/${workbook.grade}/tang-cuong/`}>Tăng cường ({reinforcementCount}) →</a>}
    </div>
  </aside>
)}

<style>
  .workbook-link {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    gap: 0.75rem 1rem; padding: 1rem; margin: 1.5rem 0;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--code-bg);
  }
  h2 { margin: 0; font: 600 0.95rem/1.5 var(--font-mono); }
  p { margin: 0.25rem 0 0; font-size: 0.875rem; color: var(--text-soft); }
  .workbook-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 0.75rem;
    border: 1px solid var(--accent); border-radius: var(--radius); background: var(--bg);
    font: 600 0.875rem var(--font-mono);
  }
</style>
